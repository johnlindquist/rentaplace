{
  "name": "rentaplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local vacation rental marketplace for guests and hosts.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=src src/server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning src/server.ts",
    "seed": "node --disable-warning=ExperimentalWarning data/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test --test-isolation=none test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "node --disable-warning=ExperimentalWarning test/bench.ts",
    "journey": "node --disable-warning=ExperimentalWarning test/journey.ts",
    "rap": "node --disable-warning=ExperimentalWarning bin/rap.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.18.2",
  "license": "MIT"
}
